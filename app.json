{
  "expo": {
    "name": "GelatoFlow App",
    "slug": "gelato-flow-app",
    "version": "1.0.0r1",
    "scheme": "gelato",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.gelato.app"
    },
    "android": {
      "package": "mx.gelato.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34e3d317-1a87-43a0-a9ef-1c4ec47d36d5"
      }
    }
  }
}
